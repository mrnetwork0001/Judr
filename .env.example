# SERV reasoning API. Get a key at https://console.openserv.ai/signup
# Without this, Judr runs in replay mode: the recorded run plays back through
# the same verification and confidence logic, clearly labelled in the UI.
SERV_API_KEY=

# Optional overrides.
# SERV_BASE_URL=https://inference-api.openserv.ai/v1
# SERV_MODEL=gpt-5.4-mini

# How many times the adjudication step is re-run to measure decision stability.
# Set to 1 to disable (confidence then reports 1/1 and rests on clause support).
# JUDR_CONSENSUS_RUNS=3

# Appeal window before the vault will honour a release call, in ms.
# JUDR_APPEAL_WINDOW_MS=45000

# Replay playback speed multiplier. Lower is faster; 1 matches a live run.
# JUDR_REPLAY_PACE=1

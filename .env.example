# ---- SERV reasoning API (required) ------------------------------------------
# Get a key at https://console.openserv.ai/signup and enable data collection at
# Settings → Organization. Judr decides cases live; there is no recorded fallback.
SERV_API_KEY=

# Optional overrides.
# SERV_BASE_URL=https://inference-api.openserv.ai/v1
# SERV_MODEL=gpt-5.4-mini

# ---- Escrow agent: Coinbase Developer Platform via AgentKit (required for payouts)
# Create an API key and a Wallet Secret at https://portal.cdp.coinbase.com
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
CDP_WALLET_SECRET=

# base-sepolia (default; the agent funds itself from Coinbase's faucet) or base
# (mainnet; you fund the agent's address with USDC and a little ETH yourself).
# CDP_NETWORK=base-sepolia

# The escrow per case, in USDC. Real: it is what the agent pays the winner.
# JUDR_ESCROW_USDC=1

# Payout caps — the only thing between a public demo and an empty wallet.
# JUDR_PAYOUTS=on                        # set to off to freeze payouts
# JUDR_PAYOUTS_PER_ADDRESS_PER_DAY=1
# JUDR_DAILY_OUTFLOW_USDC=5              # default 5 on mainnet, 50 on testnet

# ---- Arbitration ------------------------------------------------------------
# How many times the adjudication step is re-run to measure decision stability.
# JUDR_CONSENSUS_RUNS=3

# Appeal window before the agent will pay out, in ms. Days, in production.
# JUDR_APPEAL_WINDOW_MS=20000
